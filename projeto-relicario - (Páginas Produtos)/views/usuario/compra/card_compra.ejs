<div class="card item-carrinho-card mb-3 p-3 shadow-sm">
  <div class="row align-items-center">
    <!-- Checkbox e Imagem -->

    <!--MODIFICAR PARA PUXAR OS DADOS DO PRODUTO DIRETO DO BANCO VIA ID-->

    <div class="col-md-5 d-flex align-items-center">
      <a href="/usuario/produtos/detalhe/<%= produto.id %>"
        class="text-decoration-none text-dark d-flex align-items-center">
        <img src="/uploads/<%= produto.imagem %>" alt="<%= produto.nome %>"
          class="img-fluid rounded produto-img me-3" />
      </a>

      <div>
        <h5 class="fw-bold produto-titulo-carrinho mb-1">
          <%= produto.nome %>
        </h5>
        <p class="text-muted small mb-0">Material: <%= produto.material %>
        </p>
        <p class="text-muted small mb-0">Ano: <%= produto.fabricacao %>
        </p>
      </div>
    </div>

    <! -- Detalhes de Quantidade, Valor e Lixeira -->
      <div class="col-md-7 d-flex justify-content-between align-items-center mt-3 mt-md-0">
        <div>

          <!--ADICONAR BOTÃO PARA AUMENTAR E DIMINUIR QUANTIDADE DOS PRODUTOS-->

          <div class="d-flex align-items-center gap-3">
            <p class="small mb-1 text-secondary">Quantidade:</p>
            <!-- Botão Diminuir com fundo vermelho/vinho -->
            <form action="/carrinho/diminuir/<%= produto.id %>" method="POST" class="mb-0">
              <button type="submit" class="btn text-white"
                style="background-color: #3b0e0e; border: none;">-</button>
            </form>

            <!-- Quantidade -->
            <span class="fw-bold quantidade-item">
              <%= item.quantidade %>
            </span>

            <!-- Botão Aumentar com fundo vermelho/vinho -->
            <form action="/carrinho/adicionar/<%= produto.id %>" method="POST" class="mb-0">
              <button type="submit" class="btn text-white"
                style="background-color: #3b0e0e; border: none;">+</button>
            </form>

          </div>

          <p class="small mb-0 text-secondary">Valor Unitário: <%= Number(produto.valor).toLocaleString('pt-BR', {
              minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </p>
        </div>
        <div class="text-end">
          <p class="small mb-0 text-secondary">Valor Total: <%= Number(produto.valor *
              item.quantidade).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %>
          </p>
          <form action="/carrinho/remover/<%= produto.id %>" method="POST">
            <button class="btn btn-sm btn-link text-dark p-0" title="Remover item">
              <i class="bi bi-trash-fill"></i>
            </button>
          </form>
        </div>
      </div>
  </div>
</div>