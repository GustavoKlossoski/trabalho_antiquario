<%- include('partials/header') %>

    <main class="container py-5 m-auto d-flex flex-column align-items-center justify-content-center flex-grow-1">

        <div class="text-white p-5 rounded shadow-lg w-50" style="background-color: #560B18">

            <h4 class="display-6">
                <img src="/imagens/logo_relicario.png" height="30">
                Relicário - Administrador
            </h4>

            <hr>

            <form action="/admin/login" method="POST">
                <div class="row">

                    <div class="col-md-12">

                        <div class="mb-3">
                            <label for="email" class="form-label">E-mail</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>

                        <div class="mb-3">
                            <label for="senha" class="form-label">Senha</label>
                            <input type="password" class="form-control" id="senha" name="senha" required>
                        </div>

                        <button type="submit" class="btn mt-3 w-100" style="background-color: #F2E5C6">Entrar</button>

                    </div>

                </div>
            </form>

<!-- REALIZAR VERIFICAÇÃO NO BANCO DE DADOS --> 

        </div>
    </main>

    <%- include('partials/footer') %>