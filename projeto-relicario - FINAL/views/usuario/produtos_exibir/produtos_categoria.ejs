<%- include('../partials/header_usuario') %>

<div class="container-menu-categorias py-3 px-4" style="background-color: transparent !important;">
    <div class="d-flex align-items-center justify-content-between w-100">

        <!-- Lado esquerdo: Apenas o ícone/brasão e os links -->
        <div class="d-flex align-items-center gap-4">
            <a class="text-decoration-none d-flex align-items-center m-0" href="/">
                <img src="/imagens/logo_relicario.png" alt="Logo" style="height: 38px; object-fit: contain;">
            </a>
            <a class="text-decoration-none" style="color: #3b0e0e; font-size: 1.1rem; font-family: 'Georgia', serif;" href="/usuario/categorias_lista">Categorias</a>
            <a class="text-decoration-none" style="color: #3b0e0e; font-size: 1.1rem; font-family: 'Georgia', serif;" href="/usuario/sobre">Sobre</a>
        </div>

        <!-- Lado direito: Botão Voltar estilizado em pílula escura -->
        <div>
            <a href="/usuario/categorias_lista" class="btn px-4 py-2 rounded-pill shadow-sm text-white" style="background-color: #4a0e17; font-size: 0.95rem; border: none;">Voltar</a>
        </div>

    </div>
</div>

<main class="container my-5 pagina-categoria-fundo">

  <!-- Título da Categoria Selecionada -->
  <h2 class="text-uppercase titulo-pagina-categorias text-center mb-8">
    <%= typeof categoria === 'object' ? categoria.nome : categoria %>
  </h2>
  
  <!-- Lista de Produtos da Categoria -->
  <div class="row g-4 mt-3">
    <% if (produtos && produtos.length > 0) { %>
      <% produtos.forEach(function(produto) { %>
        <div class="col-md-4">
          <%- include('../../usuario/componentes/card', { produto: produto }) %>
        </div>
      <% }); %>
    <% } else { %>
      <div class="col-12 text-center py-5">
        <p class="text-muted">Nenhum produto cadastrado nesta categoria no momento.</p>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer_usuario') %>