<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">

    <div class="card shadow-sm">

        <div class="card-header text-white" style="background-color: #3B010B">
            <div class="d-flex justify-content-between">
                <h4 class="mb-0">
                    <i class="bi bi-tags"></i>
                    Administradores
                </h4>

                <a href="/admin/login/cadastro" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Novo Administrador
                </a>
            </div>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>E-mail</th>
                            <th>Senha</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% logins.forEach(usuarios => { %>

                            <tr>
                                <td><%= usuarios.id %></td>
                                <td><%= usuarios.nome %></td>
                                <td><%= usuarios.email %></td>
                                <td><%= usuarios.senha %></td>

                                <td>
                                    <a href="/admin/login/editar/<%= usuarios.id %>" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </a>

                                    <a href="/admin/login/excluir/<%= usuarios.id %>" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Excluir
                                    </a>
                                </td>
                            </tr>

                        <% }) %>

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</main>

<%- include('../partials/footer') %>
