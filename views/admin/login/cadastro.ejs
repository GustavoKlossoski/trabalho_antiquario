<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">
    <div class="card shadow-sm col-md-8 mx-auto">
        <div class="card-header text-white" style="background-color: #3B010B">
            <h4 class="mb-0">
                <i class="bi bi-person-plus"></i>
                <%= login ? 'Editar Administrador' : 'Cadastrar Administrador' %>
            </h4>
        </div>

        <div class="card-body">
            <form action="<%= login ? `/admin/login/atualizar/${login.id}` : '/admin/login/cadastrar' %>" method="POST">
                <div class="mb-3">
                    <label for="nome" class="form-label">Nome Completo</label>
                    <input type="text" class="form-control" id="nome" name="nome" placeholder="Digite o nome" value="<%= login ? login.nome : '' %>" required>
                </div>

                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="nome@exemplo.com" value="<%= login ? login.email : '' %>" required>
                </div>

                <div class="mb-3">
                    <label for="senha" class="form-label">Senha</label>
                    <input type="password" class="form-control" id="senha" name="senha" placeholder="Digite a senha" value="<%= login ? login.senha : '' %>" required>
                </div>


                <button type="submit" class="btn text-white" style="background-color: #3B010B">
                    <i class="bi bi-check-circle"></i>
                    <%= login ? 'Salvar alterações' : 'Cadastrar' %>
                </button>

                <a href="/admin/login/listar" class="btn btn-secondary">
                    Cancelar
                </a>
            </form>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>