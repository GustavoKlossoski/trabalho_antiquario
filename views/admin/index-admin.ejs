<%- include('partials/header') %>
<%- include('partials/menu') %>

<main class="container py-5">

    <div class="bg-white p-5 rounded shadow-sm">

        <h1 class="display-6">
            <img src="/imagens/logo_relicario.png" height="30" class="d-inline-block align-text-top me-1">
            Relicário - Administrador
        </h1>

        <p class="lead">
            Área administrativa para gerenciamento de produtos.
        </p>

        <hr>

<!-- PRODUTOS : background-color: #75162D -->

        <div class="row">

            <div class="col-md-4 mb-3">
                <div class="card h-100 text-white" style="background-color: #75162D">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-box-seam"></i>
                            Produtos
                        </h5>
                        <p class="card-text">
                            Cadastre e consulte os produtos disponíveis na loja.
                        </p>
                        <a href="/admin/produtos" class="btn btn-light">
                            Ver produtos
                        </a>
                    </div>
                </div>
            </div>

<!-- CATEGORIAS : background-color: #560B18 -->

            <div class="col-md-4 mb-3">
                <div class="card h-100 text-white" style="background-color: #560B18">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-tags"></i>
                            Categorias
                        </h5>
                        <p class="card-text">
                            Cadastre e consulte as categorias de produtos.
                        </p>
                        <a href="/admin/categorias" class="btn btn-light">
                            Ver categorias
                        </a>
                    </div>
                </div>
            </div>

<!-- USUÁRIOS : background-color: #3B010B -->

            <div class="col-md-4 mb-3">
                <div class="card h-100 text-white" style="background-color: #3B010B">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="bi bi-person-circle"></i>
                            Administradores
                        </h5>
                        <p class="card-text">
                            Cadastre e consulte os administradores.
                        </p>
                        <a href="/admin/login/listar" class="btn btn-light">
                            Ver Administradores
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>

</main>

<%- include('partials/footer') %>
