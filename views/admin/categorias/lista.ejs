<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">

    <div class="card shadow-sm">

        <div class="card-header text-white" style="background-color: #560B18">
            <div class="d-flex justify-content-between">
                <h4 class="mb-0">
                    <i class="bi bi-tags"></i>
                    Categorias
                </h4>

                <a href="/admin/categorias/form-cadastrar" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Nova categoria
                </a>
            </div>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-striped table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nome</th>
                            <th>Imagem</th>
                            <th>Descrição</th>
                            <th>Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% categorias.forEach(categoria => { %>

                            <tr>
                                <td><%= categoria.id %></td>
                                <td><%= categoria.nome %></td>

                                <td>
                                    <% if (categoria.imagem) { %>
                                        <img src="/uploads/<%= categoria.imagem %>" 
                                             alt="<%= categoria.nome %>" 
                                             class="img-thumbnail" 
                                             style="width: 60px; height: 60px; object-fit: cover;">
                                    <% } else { %>
                                        <span class="badge bg-secondary">Sem Foto</span>
                                    <% } %>
                                </td>

                                <td><%= categoria.descricao %></td>

                                <td>
                                    <a href="/admin/categorias/editar/<%= categoria.id %>" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil"></i>
                                        Editar
                                    </a>

                                    <a href="/admin/categorias/excluir/<%= categoria.id %>" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                        Excluir
                                    </a>
                                </td>
                            </tr>

                        <% }) %>

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</main>

<%- include('../partials/footer') %>