<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<main class="container py-4">
    <div class="card shadow-sm">
        <div class="card-header text-white" style="background-color: #75162D;">
            <div class="d-flex justify-content-between">
                <h4 class="mb-0">
                    <i class="bi bi-box-seam"></i>
                    Produtos
                </h4>
                <a href="/admin/produtos/form-cadastrar" class="btn btn-light btn-sm">
                    <i class="bi bi-plus-circle"></i>
                    Novo produto
                </a>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Produto</th>
                            <th>Categoria</th>
                            <th>Valor</th>
                            <th>Estoque</th>
                            <th>Imagem</th>
                            <th>Destaque</th>
                            <th>Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% produtos.forEach(produto => { %>
                            <tr>
                                <td><%= produto.id %></td>
                                <td><%= produto.nome %></td>
                                <td><%= produto.categoria %></td>
                                <td>R$ <%= produto.valor %></td>
                                <td><%= produto.estoque %></td>
                                <td>
                                    <% if (produto.imagem) { %>
                                        <img src="/uploads/<%= produto.imagem %>" 
                                             alt="<%= produto.nome %>" 
                                             class="img-thumbnail" 
                                             style="width: 60px; height: 60px; object-fit: cover;">
                                    <% } else { %>
                                        <span class="badge bg-secondary">Sem Foto</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (produto.destaque === 1) { %>
                                        <span class="badge bg-success">Sim</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">Não</span>
                                    <% } %>
                                </td>   
                                <td>
                                    <a href="/admin/produtos/editar/<%= produto.id %>" class="btn btn-warning btn-sm">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <a href="/admin/produtos/excluir/<%= produto.id %>" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i>
                                        Excluir
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>