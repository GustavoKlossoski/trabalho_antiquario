<%- include('usuario/partials/header_usuario') %>

<!-- Torna o menu transparente e com posição absoluta apenas nesta página, sem mexer no CSS global -->
<style>
  .navbar-relicario {
      position: absolute !important;
      background: transparent !important;
      background-color: transparent !important;
      width: 100%;
      z-index: 10;
  }
  /* Remove margens e paddings indesejados para colar nas bordas */
  .banner-full-width {
      width: 100vw;
      position: relative;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
  }
</style>

<%- include('usuario/partials/menu_usuario') %>

<!-- Banner em Largura Total -->
<div class="banner-full-width">
  <div id="carouselStacked" class="carousel slide" data-bs-ride="carousel">
    <div class="carousel-inner">
      <div class="carousel-item active">
        <img src="/imagens/banner1.png" class="d-block w-100" alt="Responsive image">
      </div>
      <div class="carousel-item">
        <img src="/imagens/banner2.png" class="d-block w-100" alt="Responsive image">
      </div>
      <div class="carousel-item">
        <img src="/imagens/banner3.png" class="d-block w-100" alt="Responsive image">
      </div>
    </div>
  </div>

  <!-- Conteúdo sobreposto / centralizado no banner -->
  <div class="position-absolute top-50 start-50 translate-middle text-center w-100 px-3" style="z-index: 5;">
    <!-- Arabesco -->
    <div class="arabesco mb-2">
      <img src="/imagens/arabesco_banner.png" alt="Arabesco" class="img-fluid" style="max-height: 60px;">
    </div>

    <h1 class="fw-normal mb-1 banner-titulo-principal text-white">RELICÁRIO</h1>
    <p class="fst-italic mb-1 mt-1 birthstone-bounce-regular banner-subtitulo-bounce text-white">Antiquário</p>
    <p class="fst-italic mb-3 banner-subtitulo-citacao text-white">“Preserve o Passado, transforme o Presente”</p>
    <a href="/colecao" class="btn px-4 py-2 rounded-pill text-dark shadow-sm banner-btn-colecao bg-white">Ver Coleção</a>
  </div>
</div>

<!-- Cards (Destaques) -->
<div class="container my-5">
  <h2 class="fw-bold mb-4 titulo-destaques">Destaques</h2>
  
  <div class="row g-4">
  <% if (produtos && produtos.length > 0) { %>
    <% produtos.forEach(function(produto) { %>
      <% if (produto.destaque == 1 || produto.destaque === true) { %>
        <div class="col-md-4">
          <%- include('usuario/componentes/card', { produto: produto }) %>
        </div>
      <% } %>
    <% }); %>
  <% } else { %>
    <div class="col-12">
      <p class="text-muted">Nenhum produto cadastrado no momento.</p>
    </div>
  <% } %>
  </div>
</div>

<%- include('usuario/partials/footer_usuario') %>